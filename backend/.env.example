# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.

# Gemini API Configuration
GEMINI_API_KEY=your_api_key_here

# Model Selection
# Options: gemini-1.5-flash, gemini-1.5-flash-8b, gemini-1.5-pro, gemini-1.0-pro
# Default: gemini-1.5-flash-8b
GEMINI_MODEL=gemini-1.5-flash-8b

# CORS: comma-separated list of exact origins allowed to call the API.
# Wildcards are not supported on purpose. Credentials are never allowed.
# Default: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits. Uploads stream to a temp file and are rejected the moment
# either ceiling is crossed, so an oversized file never reaches memory.
# Defaults: 50 MB, 1,000,000 rows
MAX_UPLOAD_MB=50
MAX_UPLOAD_ROWS=1000000

# Training cost. Every candidate model is cross-validated, so breadth is not
# free: ten candidates over five folds is fifty fits. Cap how many candidates a
# run may try when a fast answer matters more than an exhaustive one.
# 0 = no cap, use the whole registry (the default).
MAX_CANDIDATE_MODELS=0

# Analyst sandbox. Generated analysis code runs in a separate one-shot
# interpreter with these ceilings. On POSIX they are backed by setrlimit; on
# Windows the wall-clock timeout is the only hard limit (see analyst/runner.py).
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MEMORY_MB=1024

# How many tool calls one question may take before the analyst must answer.
AGENT_MAX_STEPS=6

# Guards on the paid endpoint, applied per conversation.
CHAT_MAX_MESSAGES_PER_HOUR=40
CHAT_TOKEN_BUDGET=120000

# Where jobs and the run registry are stored. Job state survives restarts and
# is shared across uvicorn workers.
# Default: sqlite:///<backend>/models/analyst.db
# DATABASE_URL=sqlite:///./models/analyst.db
#
# SQLite is right for one process and wrong for two: concurrent writers get
# "database is locked" rather than a queue, so a worker plus an API process
# needs Postgres. postgres:// and postgresql:// are both accepted and rewritten
# to the psycopg driver that is pinned.
# DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst
#
# Pool settings apply to Postgres only — SQLite has one file handle and none of
# this means anything there. Keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) × processes
# below the server's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# Recycle below the server's idle timeout, so a connection is replaced by us
# rather than found dead by a request.
DB_POOL_RECYCLE_SECONDS=1800
# How long startup waits for the database to accept connections. A worker and
# the database usually start together; retrying beats crash-looping.
DB_CONNECT_RETRY_SECONDS=30

# Logging. LOG_JSON=true emits one JSON object per line, each carrying the
# request id and (inside a training job) the job id.
LOG_LEVEL=INFO
LOG_JSON=true

# =============================================================================
# Phase 6 — multi-user and production. Every setting below is off by default:
# a single trusted operator on localhost needs none of it, and defaulting it on
# would break that install to solve a problem it does not have.
# =============================================================================

# --- Authentication ----------------------------------------------------------
# When false, every request is attributed to one implicit local owner, so every
# artifact still has an owner and switching this on later orphans nothing.
# When true, every endpoint requires 'Authorization: Bearer <api key>'.
AUTH_ENABLED=false
# Creates the first (admin) account via POST /api/auth/register with the header
# X-Bootstrap-Token. Registration is closed entirely while this is unset, and
# closes again once one account exists. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_BOOTSTRAP_TOKEN=

# =============================================================================
# PHASE 8 - HARDENING THE EDGE
# Who a caller is was Phase 6. This is what they may do, how much of it, and
# what is remembered afterwards. All of it defaults to off, and all of it is
# pointless while every account belongs to someone you know. See
# docs/security.md before turning any of it on.
# =============================================================================

# --- Per-account ceilings ----------------------------------------------------
# The Phase 5 guards are per *conversation*, which slows one session and stops
# nothing: a client that opens a new conversation each time has no ceiling at
# all. These are per account and are measured against the usage, run and job
# tables that already record everything. 0 disables a limit.
#
# The spend limit does not refund — it is checked before a call and the cost
# recorded after, so one call may cross the line rather than stop exactly on it.
# The figure is an estimate from published list prices, not an invoice.
PRINCIPAL_MAX_LLM_CALLS_PER_HOUR=0
PRINCIPAL_DAILY_SPEND_LIMIT_USD=0
# Disk and workers are the resources a paid-endpoint limit does not cover:
# uploading is free, training writes a model bundle, and an account well under
# both money limits can still occupy every worker at the cost of a few CSVs.
PRINCIPAL_MAX_RUNS=0
PRINCIPAL_STORAGE_QUOTA_MB=0
PRINCIPAL_MAX_CONCURRENT_JOBS=0

# --- Key lifecycle -----------------------------------------------------------
# More than one key may be active per account, which is what makes rotation
# "issue, roll out, revoke" instead of an outage the length of the rollout. The
# ceiling keeps "rotate" from quietly becoming "accumulate".
MAX_ACTIVE_API_KEYS=5
# 0 means issued keys do not expire. A number of days ages them out on their
# own; keys that already exist are unaffected.
API_KEY_DEFAULT_TTL_DAYS=0

# --- Sandbox isolation -------------------------------------------------------
# "subprocess" is the restricted interpreter described below under About the
# sandbox: an import denylist and an audit hook, which stop generated code that
# misbehaves and would not stop generated code that attacks.
#
# "container" runs the same runner inside `docker run --network none
# --read-only --cap-drop ALL`, which is a kernel boundary rather than an
# interpreter convention. Build the image first, then verify it:
#   docker build -f ops/Dockerfile.sandbox -t analyst-sandbox:latest ./backend
#   python ops/verify_sandbox.py --build
#
# There is deliberately no fallback: with this set to container and no runtime
# reachable, every execution fails rather than silently running unisolated.
SANDBOX_BACKEND=subprocess
# podman is a drop-in and needs no privileged daemon; prefer it where available.
SANDBOX_RUNTIME=docker
SANDBOX_IMAGE=analyst-sandbox:latest
# Empty uses the runtime's default profile, which is already an allowlist and
# already good. ops/seccomp-analyst.json is the tighter one this repo ships —
# read the caveat in docs/security.md before enabling it.
SANDBOX_SECCOMP_PROFILE=
SANDBOX_PIDS_LIMIT=128
SANDBOX_CPUS=1.0
# Starting a container is not analysis time, so it is added to the timeout
# rather than taken out of it.
SANDBOX_STARTUP_GRACE_SECONDS=10
# Only when the API is itself a container talking to the host's daemon. Bind
# mounts are resolved by that daemon against the HOST filesystem, so the path
# this process sees is not the path to mount. Set it to the host directory
# behind the models/ volume. Unset in that topology, the mount silently
# produces an empty file and the dataset appears to have no rows.
SANDBOX_HOST_MODELS_DIR=

# --- Secrets from files ------------------------------------------------------
# Every credential below also accepts a <NAME>_FILE variant naming a path, so
# Docker secrets, Kubernetes secret volumes and systemd credentials can all be
# pointed at it without this application learning about any of them:
#   GEMINI_API_KEY_FILE, ARTIFACT_SIGNING_KEY_FILE,
#   AUTH_BOOTSTRAP_TOKEN_FILE, DATABASE_URL_FILE
# The direct variable still works and still wins; setting both warns. A _FILE
# that cannot be read is fatal, because falling back to "no key" would look
# like a choice. Environment variables are readable by anything that can run
# `docker inspect` or take a core dump; a file is not.

# --- Artifact integrity ------------------------------------------------------
# Model bundles are HMAC-signed on write and verified before joblib.load, which
# executes pickle opcodes and would otherwise run whatever bytes it is handed.
# Leave unset on a single machine and a key is generated and kept beside the
# artifacts; set it explicitly when several processes must verify the same
# files, or they will each generate a different key and reject each other's —
# and the error will say the artifact was tampered with, which it was not.
# /readyz reports checks.artifacts.ok=false whenever this is unset in a
# deployment that has a worker, a bucket, or a shared database. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ARTIFACT_SIGNING_KEY=

# --- Job queue ---------------------------------------------------------------
# "inline" runs training in the web process via BackgroundTasks: simple, and it
# dies with a restart. "rq" hands the job to Redis and a separate worker
# (python worker.py), so restarting the API cannot kill a run in progress.
# An unreachable Redis falls back to inline rather than accepting jobs that
# nothing would run.
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=analyst
QUEUE_JOB_TIMEOUT_SECONDS=3600

# --- Object storage ----------------------------------------------------------
# "local" keeps artifacts on this machine's disk. "s3" mirrors them to a bucket
# after each run and pulls them back on a miss, so more than one web process can
# serve the same run. Credentials come from the usual boto3 chain (environment,
# profile, instance role) and are deliberately not settings here.
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=analyst
# Set for MinIO and other S3-compatible endpoints. With the compose storage
# profile: http://minio:9000 from a container, http://localhost:9000 from the
# host. Credentials go in AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, which boto3
# reads directly — they are not settings, so they cannot end up in a log line.
S3_ENDPOINT_URL=
S3_REGION=

# --- Data lifecycle ----------------------------------------------------------
# Days before a run's artifacts and conversations become eligible for purging.
# 0 disables expiry and keeps data until it is deleted by hand. The purge runs
# at startup and on POST /api/admin/retention/purge; put that on a cron entry
# if you want it more often than a restart.
RETENTION_DAYS=0

# =============================================================================
# PHASE 9 - KEEPING A MODEL HONEST AFTER IT SHIPS
# Every phase before this one judged a model once, at training time. These
# settings are what watch it afterwards: what a model is asked, whether that
# has moved, whether its confidence can be trusted, and what a retrained
# challenger has to beat before it replaces what is being served. See
# docs/monitoring.md.
#
# Mostly ON by default, unlike Phase 6 and Phase 8 — the difference is
# deliberate. A rate limit changes what a caller may do; this only stops
# throwing away a record of what already happened. A model nobody is watching
# is the exact failure this phase exists to prevent.
# =============================================================================

# --- Prediction logging -------------------------------------------------------
# Every served prediction — batch or single row — is logged with its inputs,
# output, model version, and latency. Off drops all of it: volume, latency,
# and drift detection, which reads its live side from this log.
PREDICTION_LOGGING_ENABLED=true
# Off keeps volume and latency monitoring and drops feature values, which are
# exactly as sensitive as the training rows they resemble. Costs drift
# detection entirely — there is nothing left to compare against the reference.
PREDICTION_LOG_INPUTS=true
# A batch above this is sampled evenly across the file (not truncated to its
# head, which would bias toward whatever a sorted export starts with) and every
# sampled row is flagged accordingly.
PREDICTION_LOG_MAX_ROWS=200

# --- Drift ---------------------------------------------------------------------
# How many recent predictions a drift comparison reads.
DRIFT_SAMPLE_SIZE=1000
# Below this many logged predictions, drift is reported as insufficient rather
# than given a verdict. Not a round default — see docs/monitoring.md and
# backend/tests/test_drift.py for the simulation that set it: at ten bins and a
# lower floor, a same-distribution sample read as material drift on nearly
# every trial.
DRIFT_MIN_ROWS=200

# --- Calibration -----------------------------------------------------------
# Fit a calibrated variant of a classifier and keep it only if it measurably
# improves the holdout's expected calibration error. Off leaves calibration
# *measured* and reported in the metadata and every prediction response; it
# only skips acting on the measurement.
CALIBRATE_PROBABILITIES=true

# --- Retraining --------------------------------------------------------------
# How much better a retrained challenger must score than the champion, on the
# run's own selection metric, before it is promoted. A margin rather than "any
# improvement": refitting the same model on the same data with a different
# seed moves the score on its own, and promoting on any improvement at all
# means promoting that noise, repeatedly, and calling it progress.
CHALLENGER_PROMOTION_MARGIN=0.01

# --- Observability -----------------------------------------------------------
# Prometheus exposition on GET /metrics. Labels are bounded — method,
# normalised path, model, outcome — and never include a run key or filename.
METRICS_ENABLED=true
# Error reporting. Empty disables it. Dataset contents are never attached:
# send_default_pii is off and only exception data is transmitted.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
