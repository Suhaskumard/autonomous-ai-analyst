# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.

# Gemini API Configuration
GEMINI_API_KEY=your_api_key_here

# Model Selection
# Options: gemini-1.5-flash, gemini-1.5-flash-8b, gemini-1.5-pro, gemini-1.0-pro
# Default: gemini-1.5-flash-8b
GEMINI_MODEL=gemini-1.5-flash-8b

# CORS: comma-separated list of exact origins allowed to call the API.
# Wildcards are not supported on purpose. Credentials are never allowed.
# Default: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits. Uploads stream to a temp file and are rejected the moment
# either ceiling is crossed, so an oversized file never reaches memory.
# Defaults: 50 MB, 1,000,000 rows
MAX_UPLOAD_MB=50
MAX_UPLOAD_ROWS=1000000

# Training cost. Every candidate model is cross-validated, so breadth is not
# free: ten candidates over five folds is fifty fits. Cap how many candidates a
# run may try when a fast answer matters more than an exhaustive one.
# 0 = no cap, use the whole registry (the default).
MAX_CANDIDATE_MODELS=0

# Where jobs and the run registry are stored. Job state survives restarts and
# is shared across uvicorn workers. Postgres works too: postgresql://...
# Default: sqlite:///<backend>/models/analyst.db
# DATABASE_URL=sqlite:///./models/analyst.db

# Logging. LOG_JSON=true emits one JSON object per line, each carrying the
# request id and (inside a training job) the job id.
LOG_LEVEL=INFO
LOG_JSON=true
