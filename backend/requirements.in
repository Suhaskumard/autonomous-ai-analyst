# Direct dependencies. Compile to a fully pinned requirements.txt with:
#   uv pip compile backend/requirements.in -o backend/requirements.txt
fastapi
uvicorn[standard]
pandas
numpy
scikit-learn
xgboost
shap
joblib
python-multipart
scipy
google-genai
python-dotenv
pydantic-settings
sqlmodel
# The analyst's plot tool draws figures during chat (analyst/runner.py
# renders them to an in-memory PNG, Agg backend, no display needed). Pinned
# here rather than left implicit: analyst/runner.py's own comment already
# assumed "matplotlib ships with the app", but nothing actually shipped it —
# only a machine that happened to have it installed some other way passed
# the plotting tests, and a clean install silently lost the feature.
matplotlib
# Phase 4: a broader model registry and SMOTE oversampling. CatBoost is also
# supported when installed, but is not pinned here: the wheel is ~100 MB and
# LightGBM covers the same ground at a fraction of the install cost.
lightgbm
imbalanced-learn

# Phase 6: multi-user and production.
# rq/redis back QUEUE_BACKEND=rq, boto3 backs STORAGE_BACKEND=s3, and the
# observability pair is optional at runtime — observability.py degrades to
# no-ops when either is absent, so a smaller install still serves requests.
rq
redis
boto3
prometheus-client
sentry-sdk

# Phase 7: the production path, proven rather than assumed.
# Alembic owns the schema now that a worker and more than one API process write
# to it concurrently — `create_all` plus a column-patching helper cannot express
# a rename or a backfill. psycopg is the driver for the Postgres that replaces
# SQLite in that same configuration; it is unused on the SQLite default.
alembic
psycopg[binary]

# Phase 10: exporting a trained pipeline. skl2onnx converts the sklearn half
# (ColumnTransformer, OneHotEncoder, StandardScaler, the built-in estimators);
# onnxmltools registers converters for XGBoost/LightGBM on top of it. Neither
# covers sklearn's TargetEncoder or HistGradientBoosting*, which ml/export.py
# detects and refuses rather than silently producing a wrong bundle — see its
# module docstring. ml/export.py imports both behind a try/except, the same
# optional-dependency shape as xgboost/lightgbm in train.py.
skl2onnx
onnxmltools
