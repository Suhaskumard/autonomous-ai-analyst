# Python
__pycache__/
*.pyc

# Env files — never commit real credentials; .env.example is the tracked template
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Node
node_modules/
frontend/node_modules/

# Vite cache and build output (built artifacts do not belong in git)
.vite/
frontend/dist/

# Scratch/temp
backend/scratch/

# Generated ML artifacts — regenerated on every run, never committed
backend/models/metadata/*
backend/models/saved_models/*
!backend/models/metadata/.gitkeep
!backend/models/saved_models/.gitkeep

# Job + run registry (SQLite, plus its write-ahead log) — runtime state
backend/models/*.db
backend/models/*.db-shm
backend/models/*.db-wal

# Uploads handed to an out-of-process worker; deleted when the job ends
backend/models/spool/

# The artifact signing key, when one is generated rather than configured.
# It is a secret: anything that can produce a valid signature can get a model
# bundle past verification and into joblib.load.
backend/models/.artifact_signing_key

# Secret scanner baseline is tracked; its cache is not
.secrets.baseline.tmp

# OS
.DS_Store
Thumbs.db
